import { toTypedSchema } from '@vee-validate/zod';
import * as z from 'zod';

/**
 * Initial values of the [[ label ]] translation create form, for the given locale or one to choose.
 */
export const create[[ Model ]]TranslationInitialValues = (locale = '') => ({
    locale,
[[ translationBlank ]]
});

/**
 * Validation schema of the [[ label ]] translation create form.
 */
export const create[[ Model ]]TranslationSchema = toTypedSchema(
    z.object({
        locale: z.string().min(1),
[[ translationSchemaFields ]]
    }),
);
