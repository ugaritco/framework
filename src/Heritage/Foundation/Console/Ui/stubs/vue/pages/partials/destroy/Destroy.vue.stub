<script setup lang="ts">
import { Button } from '@/components/ui/button';
import { Checkbox } from '@/components/ui/checkbox';
import {
    FormControl,
    FormField,
    FormItem,
    FormLabel,
    FormMessage,
} from '@/components/ui/form';
import { Input } from '@/components/ui/input';
import { useFormHandlers } from '@/composables/useFormHandlers';
import { destroy } from '@/routes/[[ model ]]';
import { Form } from '@inertiajs/vue3';
import {
    destroy[[ Model ]]InitialValues,
    destroy[[ Model ]]Schema,
} from '@module/[[ module ]]/pages/[[ model ]]/partials/destroy/form';
import type { [[ Model ]] } from '@module/[[ module ]]/types/[[ model ]]/[[ model ]]';
import { LoaderCircle } from 'lucide-vue-next';

/**
 * [[ Model ]] delete form: deletes once its [[ confirmLabel ]] is typed; `force` deletes permanently.
 */

interface Props {
    /** The [[ label ]] to delete. */
    [[ modelCamel ]]: [[ Model ]];
}

const props = defineProps<Props>();

/** Emitted after the [[ label ]] is deleted. */
const emit = defineEmits(['success']);

/** Form helpers bound to the confirmation schema of this [[ label ]]. */
const { meta, resetForm, handleError } = useFormHandlers(
    destroy[[ Model ]]Schema(props.[[ modelCamel ]]),
    destroy[[ Model ]]InitialValues(),
);

/** Resets the form and notifies the parent after a successful delete. */
const onSuccess = () => {
    resetForm();
    emit('success');
};
</script>

<template>
    <Form
        v-slot="{ processing }"
        v-bind="destroy.form([[ modelCamel ]].id)"
        :on-before="() => meta.valid"
        :on-success="onSuccess"
        :on-error="handleError"
        class="grid grid-cols-6 gap-4"
    >
        <!-- Confirmation -->
        <FormField v-slot="{ componentField }" name="confirmation">
            <FormItem class="col-span-6">
                <FormLabel>
                    {{ [[ confirmTemplate ]] }}
                    <span class="text-red">*</span>
                </FormLabel>
                <FormControl>
                    <Input
                        type="text"
                        :placeholder="String([[ entityConfirm ]])"
                        v-bind="componentField"
                    />
                </FormControl>
                <FormMessage />
            </FormItem>
        </FormField>

        <!-- Permanent delete -->
        <FormField v-slot="{ componentField }" name="force">
            <FormItem class="col-span-6 flex flex-row items-center gap-4">
                <FormControl>
                    <Checkbox v-bind="componentField" />
                </FormControl>
                <FormLabel>
                    {{ $t('[[ lang ]].attributes.force.label') }}
                </FormLabel>
                <FormMessage />
            </FormItem>
        </FormField>

        <!-- Actions -->
        <div class="col-span-6 flex justify-start gap-2">
            <Button
                type="submit"
                appearance="solid"
                color="danger"
                :disabled="processing || !meta.dirty || !meta.valid"
            >
                <LoaderCircle v-if="processing" class="h-4 w-4 animate-spin" />
                {{ $t('actions.destroy') }}
            </Button>

            <Button
                type="button"
                appearance="outline"
                color="neutral"
                :disabled="processing"
                @click="resetForm()"
            >
                {{ $t('actions.reset') }}
            </Button>
        </div>
    </Form>
</template>
