<script setup lang="ts">
import HeadingSmall from '@/components/HeadingSmall.vue';
import { show as artifact } from '@/routes/[[ module ]]/artifact';
[[ @index ]]
import { index } from '@/routes/[[ model ]]';
[[ @end ]]
import type { BreadcrumbItem } from '@/types';
import { Head } from '@inertiajs/vue3';
import { [[ Module ]]Layout } from '@module/[[ module ]]/layouts';
import { [[ updateComponent ]] } from '@module/[[ module ]]/pages/[[ model ]]/partials';
import type { [[ Model ]] } from '@module/[[ module ]]/types/[[ model ]]/[[ model ]]';
import { trans } from 'laravel-vue-i18n';
import { computed } from 'vue';

/**
 * [[ Model ]] edit page: the update form in a full page.
 */

interface Props {
    /** The [[ label ]] being edited. */
    data: [[ Model ]];
}

const props = defineProps<Props>();

/** Breadcrumb trail of the edit page. */
const breadcrumbItems = computed<BreadcrumbItem[]>(() => [
    { title: trans('[[ module ]]::artifact.name'), href: artifact().url },
    { title: trans('[[ lang ]].plural_definite'), href: [[ indexHref ]] },
    {
        title: trans('presentation.edit.title', {
            model_singular: trans('[[ lang ]].singular'),
            entity: String([[ propsLabel ]]),
        }),
        href: '#',
    },
]);
</script>

<template>
    <Head :title="$t('[[ lang ]].plural')" />

    <[[ Module ]]Layout :breadcrumbs="breadcrumbItems">
        <div
            class="flex items-center justify-between rounded-xl bg-primary/3 p-4 ring-1 ring-primary/5"
        >
            <HeadingSmall
                :title="
                    $t('presentation.edit.title', {
                        model_singular: $t('[[ lang ]].singular'),
                        entity: String([[ dataLabel ]]),
                    })
                "
                :description="
                    $t('presentation.edit.description', {
                        model_singular: $t('[[ lang ]].singular'),
                        entity: String([[ dataLabel ]]),
                    })
                "
            />
        </div>

        <[[ updateComponent ]] :[[ modelCamel ]]="data" />
    </[[ Module ]]Layout>
</template>
