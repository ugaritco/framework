<script setup lang="ts">
import { Button } from '@/components/ui/button';
import {
    Dialog,
    DialogContent,
    DialogDescription,
    DialogHeader,
    DialogTitle,
    DialogTrigger,
} from '@/components/ui/dialog';
import { Update, UpdateFeature } from '@module/[[ module ]]/pages/[[ model ]]/partials';
import type { [[ Model ]] } from '@module/[[ module ]]/types/[[ model ]]/[[ model ]]';
import { Edit } from 'lucide-vue-next';
import { ref } from 'vue';

/**
 * [[ Model ]] update dialog: the update form in a modal, opened by a text or icon trigger. It
 * shows the feature form, saving the [[ label ]] with its translations, unless `asFeature` is
 * false, which shows the form of its own fields.
 */

interface Props {
    /** The [[ label ]] being edited. */
    [[ modelCamel ]]: [[ Model ]];

    /** Renders an icon trigger instead of the default text button. */
    asIcon?: boolean;

    /** Shows the feature form, with a section of translated fields per locale. */
    asFeature?: boolean;
}

withDefaults(defineProps<Props>(), {
    asIcon: false,
    asFeature: true,
});

/** Whether the dialog is open. */
const open = ref(false);
</script>

<template>
    <Dialog v-model:open="open">
        <DialogTrigger as-child @click.stop>
            <Button
                v-if="!asIcon"
                appearance="outline"
                color="primary"
                data-test="update-[[ model ]]-button"
            >
                {{ $t('actions.edit') }}
            </Button>

            <Button
                v-else
                appearance="outline"
                color="neutral"
                size="sm"
                data-test="update-[[ model ]]-button"
            >
                <Edit class="h-4 w-4 text-primary" />
            </Button>
        </DialogTrigger>

        <DialogContent>
            <DialogHeader>
                <DialogTitle>
                    {{
                        $t('presentation.edit.title', {
                            model_singular: $t('[[ lang ]].singular'),
                            entity: String([[ entityLabel ]]),
                        })
                    }}
                </DialogTitle>
                <DialogDescription>
                    {{
                        $t('presentation.edit.description', {
                            model_singular: $t('[[ lang ]].singular'),
                            entity: String([[ entityLabel ]]),
                        })
                    }}
                </DialogDescription>
            </DialogHeader>

            <!-- The feature form with its translations, or the form of its own fields -->
            <UpdateFeature
                v-if="asFeature"
                :[[ modelCamel ]]="[[ modelCamel ]]"
                @success="open = false"
            />
            <Update v-else :[[ modelCamel ]]="[[ modelCamel ]]" @success="open = false" />
        </DialogContent>
    </Dialog>
</template>
