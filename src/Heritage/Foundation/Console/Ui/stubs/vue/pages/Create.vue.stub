<script setup lang="ts">
import HeadingSmall from '@/components/HeadingSmall.vue';
import { show as artifact } from '@/routes/[[ module ]]/artifact';
[[ @index ]]
import { index } from '@/routes/[[ model ]]';
[[ @end ]]
import type { BreadcrumbItem } from '@/types';
import { Head } from '@inertiajs/vue3';
import { [[ Module ]]Layout } from '@module/[[ module ]]/layouts';
import { [[ storeComponent ]] } from '@module/[[ module ]]/pages/[[ model ]]/partials';
import { trans } from 'laravel-vue-i18n';
import { computed } from 'vue';

/**
 * [[ Model ]] create page: the create form in a full page.
 */

/** Breadcrumb trail of the create page. */
const breadcrumbItems = computed<BreadcrumbItem[]>(() => [
    { title: trans('[[ module ]]::artifact.name'), href: artifact().url },
    { title: trans('[[ lang ]].plural_definite'), href: [[ indexHref ]] },
    {
        title: trans('presentation.create.title', {
            model_singular: trans('[[ lang ]].singular'),
        }),
        href: '#',
    },
]);
</script>

<template>
    <Head :title="$t('[[ lang ]].plural')" />

