            'model_singular' => trans('{{ lang }}.singular'),
            'model_plural' => trans('{{ lang }}.plural'),
            'model_plural_definite' => trans('{{ lang }}.plural_definite'),
            'routeBase' => '{{ route }}',
            'entity' => $subject instanceof {{ model }} ? $subject->getRouteKey() : null,
        ];
