<?php

namespace {{ rootNamespace }}\Http\Resources\{{ model }}\Translation;

use Heritage\Http\Request;
use Heritage\Http\Resources\Json\JsonResource;

/**
 * JSON resource representing one {{ model }} translation, its locale given as a code.
 */
class {{ model }}TranslationResource extends JsonResource
{
    /**
     * Disable the default "data" wrapper for this resource.
     *
     * @var string|null
     */
    public static $wrap = null;

    /**
     * Transform the resource into its API array representation.
     *
     * @param  Request  $request
     * @return array<string, mixed>
     */
    public function toArray(Request $request): array
    {
        return [
            'id' => $this->id,
            '{{ foreignKey }}' => $this->{{ foreignKey }},
            'locale' => $this->locale_code,
{{ fields }}
            'created_at' => $this->created_at,
            'updated_at' => $this->updated_at,
        ];
    }
}
