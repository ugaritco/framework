<?php

declare(strict_types=1);

namespace Ugarit\Artifacts\{{ StudlyName }}\Providers;

use Heritage\Support\ServiceProvider;

/**
 * Class {{ StudlyName }}ServiceProvider
 *
 * Service provider that bootstraps the {{ StudlyName }} artifact domain,
 * including migrations, routes, and any other domain-level resources.
 */
class {{ StudlyName }}ServiceProvider extends ServiceProvider
{
    /**
     * Register {{ name }} domain services into the IoC container.
     *
     * Bind interfaces, singletons, or any service-level dependencies here.
     *
     * @return void
     */
    public function register(): void
    {
        // {{ StudlyName }} service bindings
    }

    /**
     * Bootstrap {{ name }} domain migrations and other resources.
     *
     * This method is called after all providers have been registered.
     *
     * @return void
     */
    public function boot(): void
    {
        // Load database migrations from the artifact's database directory
        $this->loadMigrationsFrom(__DIR__ . '/../../database/migrations');

        // Load the translations under the '{{ name }}' namespace ({{ name }}::model.key)
        $this->loadTranslationsFrom(__DIR__ . '/../../lang', '{{ name }}');

        // Load the artifact's web routes (Route::resource for each capabilities controller)
        if (file_exists(__DIR__ . '/../../routes/web.php')) {
            $this->loadRoutesFrom(__DIR__ . '/../../routes/web.php');
        }
    }
}
