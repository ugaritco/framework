{
    "name": "heritage/queue",
    "description": "The Heritage Queue package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "homepage": "https://ugarit.com",
    "support": {
        "issues": "https://github.com/ugarit/framework/issues",
        "source": "https://github.com/ugarit/framework"
    },
    "require": {
        "php": "^8.3",
        "heritage/collections": "^1.00.00",
        "heritage/console": "^1.00.00",
        "heritage/container": "^1.00.00",
        "heritage/contracts": "^1.00.00",
        "heritage/database": "^1.00.00",
        "heritage/filesystem": "^1.00.00",
        "heritage/pipeline": "^1.00.00",
        "heritage/reflection": "^1.00.00",
        "heritage/support": "^1.00.00",
        "ugarit/serializable-closure": "^1.00.00",
        "ramsey/uuid": "^4.7",
        "symfony/process": "^7.4.5 || ^8.0.5"
    },
    "suggest": {
        "ext-filter": "Required to use the SQS queue worker.",
        "ext-mbstring": "Required to use the database failed job providers.",
        "ext-pcntl": "Required to use all features of the queue worker.",
        "ext-pdo": "Required to use the database queue worker.",
        "ext-posix": "Required to use all features of the queue worker.",
        "aws/aws-sdk-php": "Required to use the SQS queue driver and DynamoDb failed job storage (^3.322.9).",
        "heritage/redis": "Required to use the Redis queue driver (^13.0).",
        "pda/pheanstalk": "Required to use the Beanstalk queue driver (^7.0 || ^8.0)."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Heritage\\Queue\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "13.0.x-dev"
        }
    },
    "version": "1.00.00"
}
