{
    "name": "heritage/testing",
    "description": "The Heritage Testing package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "homepage": "https://ugarit.com",
    "support": {
        "issues": "https://github.com/ugarit/framework/issues",
        "source": "https://github.com/ugarit/framework"
    },
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "heritage/collections": "^1.00.00",
        "heritage/conditionable": "^1.00.00",
        "heritage/contracts": "^1.00.00",
        "heritage/macroable": "^1.00.00",
        "heritage/support": "^1.00.00"
    },
    "suggest": {
        "brianium/paratest": "Required to run tests in parallel (^7.0 || ^8.0).",
        "heritage/console": "Required to assert console commands (^13.0).",
        "heritage/database": "Required to assert databases (^13.0).",
        "heritage/http": "Required to assert responses (^13.0).",
        "mockery/mockery": "Required to use mocking (^1.6).",
        "phpunit/phpunit": "Required to use assertions and run tests (^11.5.50 || ^12.5.8)."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Heritage\\Testing\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "13.0.x-dev"
        }
    },
    "version": "1.00.00"
}
